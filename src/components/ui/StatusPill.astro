---
interface Props {
  text: string;
}
const { text } = Astro.props;
---
<div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.1] font-mono text-xs text-slate-300">
  <span class="relative flex h-2 w-2">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accentEmerald opacity-75"></span>
    <span class="relative inline-flex rounded-full h-2 w-2 bg-accentEmerald"></span>
  </span>
  <span>{text}</span>
</div>
