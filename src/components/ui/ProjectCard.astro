---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, subtitle, summary, badge, accent, metrics, stack } = project.data;

const accentStyles = {
  amber: {
    pill: 'text-amber-300 bg-amber-500/10 border-amber-500/30',
    borderHover: 'hover:border-amber-500/40 hover:shadow-glowAmber',
    link: 'text-amber-300 group-hover:text-amber-200',
  },
  emerald: {
    pill: 'text-emerald-300 bg-emerald-500/10 border-emerald-500/30',
    borderHover: 'hover:border-emerald-500/40 hover:shadow-glowEmerald',
    link: 'text-emerald-300 group-hover:text-emerald-200',
  },
  cyan: {
    pill: 'text-cyan-300 bg-cyan-500/10 border-cyan-500/30',
    borderHover: 'hover:border-cyan-500/40 hover:shadow-glowCyan',
    link: 'text-cyan-300 group-hover:text-cyan-200',
  },
}[accent];
---

<a
  href={`/projects/${project.slug}`}
  class={`group flex flex-col justify-between p-6 sm:p-8 rounded-2xl bg-surface/80 border border-white/[0.08] transition-all duration-300 ${accentStyles.borderHover}`}
>
  <div>
    <div class="flex items-center justify-between gap-3 mb-5">
      <span class={`inline-flex items-center px-2.5 py-1 rounded-md border font-mono text-[11px] tracking-wider uppercase ${accentStyles.pill}`}>
        {badge}
      </span>
      <span class="font-mono text-xs text-slate-500">{project.data.date}</span>
    </div>

    <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight mb-1.5 group-hover:text-white">
      {title}
    </h3>
    <p class="font-mono text-xs text-slate-400 mb-4">{subtitle}</p>
    <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-6">
      {summary}
    </p>

    <div class="flex flex-wrap gap-2 mb-6">
      {metrics.map((m) => (
        <span class="px-2.5 py-1 rounded-md bg-white/[0.04] border border-white/[0.07] font-mono text-[11px] text-slate-300">
          {m}
        </span>
      ))}
    </div>
  </div>

  <div class="pt-4 border-t border-white/[0.07] flex items-center justify-between gap-4">
    <div class="flex flex-wrap gap-1.5">
      {stack.slice(0, 3).map((tech) => (
        <span class="font-mono text-[11px] text-slate-500">#{tech.replace(/\s+/g, '')}</span>
      ))}
    </div>
    <span class={`font-mono text-xs font-medium inline-flex items-center gap-1 transition-transform group-hover:translate-x-1 ${accentStyles.link}`}>
      Read architecture →
    </span>
  </div>
</a>
