---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@data/site';
import { TIMELINE, CREDENTIALS, SKILL_MATRIX } from '@data/experience';
---

<BaseLayout title={`CV / Resume | ${SITE.name}`} description={`Curriculum Vitae of ${SITE.fullName} — ${SITE.role}.`}>
  <div class="max-w-4xl mx-auto">
    <!-- Action Bar -->
    <div class="no-print flex flex-wrap items-center justify-between gap-4 mb-8">
      <div>
        <div class="font-mono text-xs uppercase tracking-widest text-accentCyan">Curriculum Vitae</div>
        <h1 class="text-2xl font-bold text-white mt-1">Print-Ready Resume</h1>
      </div>
      <button
        id="print-cv-btn"
        type="button"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-accentCyan text-slate-950 font-semibold text-sm hover:bg-cyan-300 transition-colors shadow-glowCyan"
      >
        <span>Print / Save as PDF</span>
        <span>⎙</span>
      </button>
    </div>

    <!-- Resume Sheet -->
    <div class="print-card card-surface p-8 sm:p-12 space-y-10">
      <header class="border-b border-white/[0.1] pb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl font-extrabold text-white print:text-slate-900">{SITE.fullName}</h2>
          <p class="text-accentCyan print:text-slate-700 font-mono text-sm mt-1">{SITE.role}</p>
          <p class="text-slate-400 print:text-slate-600 text-xs font-mono mt-1">{SITE.specialty}</p>
        </div>
        <div class="font-mono text-xs text-slate-400 print:text-slate-600 space-y-1 sm:text-right">
          <div>{SITE.location}</div>
          <div>{SITE.email}</div>
          <div>{SITE.domain}</div>
        </div>
      </header>

      <section>
        <h3 class="font-mono text-xs uppercase tracking-widest text-accentCyan print:text-slate-800 mb-4">Experience</h3>
        <div class="space-y-6">
          {TIMELINE.map((item) => (
            <div>
              <div class="flex flex-wrap justify-between gap-2">
                <h4 class="font-bold text-white print:text-slate-900">{item.role}</h4>
                <span class="font-mono text-xs text-slate-400 print:text-slate-600">{item.period}</span>
              </div>
              <div class="font-mono text-xs text-slate-400 print:text-slate-600 mb-2">
                {item.organization} · {item.location}
              </div>
              <ul class="space-y-1.5 text-sm text-slate-300 print:text-slate-700 list-disc pl-5">
                {item.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h3 class="font-mono text-xs uppercase tracking-widest text-accentCyan print:text-slate-800 mb-4">Core Competencies</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {SKILL_MATRIX.map((group) => (
            <div>
              <div class="font-semibold text-xs text-white print:text-slate-900 mb-2">{group.category}</div>
              <p class="font-mono text-xs text-slate-400 print:text-slate-700 leading-relaxed">
                {group.items.join(' · ')}
              </p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h3 class="font-mono text-xs uppercase tracking-widest text-accentCyan print:text-slate-800 mb-4">Certifications &amp; Education</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {CREDENTIALS.map((c) => (
            <div class="text-sm text-slate-300 print:text-slate-800">
              <span class="font-semibold text-white print:text-slate-900">{c.title}</span>
              <span class="font-mono text-xs text-slate-400 print:text-slate-600"> — {c.issuer} ({c.date})</span>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  function initPrint() {
    document.getElementById('print-cv-btn')?.addEventListener('click', () => window.print());
  }
  initPrint();
  document.addEventListener('astro:after-swap', initPrint);
</script>
