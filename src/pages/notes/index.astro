---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

const notes = (await getCollection('notes')).sort((a, b) =>
  b.data.pubDate.localeCompare(a.data.pubDate)
);
---

<BaseLayout title="Engineering Notes | Nikesh Raikar" description="Technical notes on CAN FD, Automotive Ethernet, Linux packaging, and embedded test automation.">
  <section class="max-w-3xl mb-12">
    <div class="font-mono text-xs uppercase tracking-widest text-accentCyan mb-2">// Writing &amp; Field Notes</div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">Engineering Notes</h1>
    <p class="text-slate-400 text-base leading-relaxed">
      Short, practical notes on low-level automotive protocols, deterministic timing, and Linux tooling—written in MDX.
    </p>
  </section>

  <div class="space-y-5 max-w-4xl">
    {notes.map((note) => (
      <a href={`/notes/${note.slug}`} class="card-surface p-6 sm:p-7 block group">
        <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-slate-500 mb-2">
          <span>{note.data.pubDate}</span>
          <span>·</span>
          <span>{note.data.readTime}</span>
        </div>
        <h2 class="text-xl font-bold text-white group-hover:text-accentCyan transition-colors mb-2">
          {note.data.title}
        </h2>
        <p class="text-sm text-slate-400 leading-relaxed mb-4">
          {note.data.description}
        </p>
        <div class="flex flex-wrap gap-2">
          {note.data.tags.map((tag) => (
            <span class="px-2.5 py-0.5 rounded-md bg-white/[0.04] border border-white/[0.07] font-mono text-[11px] text-slate-300">
              {tag}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
