---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import StatusPill from '@components/ui/StatusPill.astro';
import ProjectCard from '@components/ui/ProjectCard.astro';
import { SITE, HERO_METRICS } from '@data/site';
import { CREDENTIALS } from '@data/experience';

const featuredProjects = (await getCollection('projects')).filter((p) => p.data.featured);
const latestNotes = (await getCollection('notes'))
  .sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate))
  .slice(0, 2);

const metricColor = {
  cyan: 'text-accentCyan',
  emerald: 'text-accentEmerald',
  amber: 'text-accentAmber',
  slate: 'text-white',
};
---

<BaseLayout>
  <!-- HERO SECTION -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center pt-4 pb-12">
    <div class="lg:col-span-8 space-y-6">
      <StatusPill text={SITE.statusText} />

      <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-extrabold text-white tracking-tight leading-[1.08]">
        Automotive Embedded Systems, ECU Diagnostics and Test Automation.
      </h1>

      <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
        I'm <span class="text-white font-semibold">{SITE.name}</span>, a Senior Automation Engineer &amp; Tech Lead in Frankfurt building deterministic validation architectures across ECUs, infotainment platforms, and vehicle buses. Explore{' '}
        <a href="/projects/ttxb-cet-logger" class="text-accentCyan underline decoration-cyan-500/40 underline-offset-4 hover:text-cyan-200">
          TTxB (ceT-logger)
        </a>{' '}
        and my{' '}
        <a href="/projects/cross-border-test-bench" class="text-accentCyan underline decoration-cyan-500/40 underline-offset-4 hover:text-cyan-200">
          Cross-Border HIL Bridge
        </a>, alongside deep-dive protocol work in UDS, CAN FD, and Automotive Ethernet.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-accentCyan text-slate-950 font-semibold text-sm hover:bg-cyan-300 transition-colors shadow-glowCyan"
        >
          <span>Explore Featured Systems</span>
          <span>→</span>
        </a>
        <a
          href="/cv"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-white font-medium text-sm transition-colors"
        >
          <span>View CV (PDF)</span>
          <span class="text-slate-400">↗</span>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center px-4 py-2.5 rounded-xl text-slate-300 hover:text-white font-medium text-sm transition-colors"
        >
          Contact
        </a>
      </div>
    </div>

    <!-- PORTRAIT CARD -->
    <div class="lg:col-span-4">
      <div class="relative rounded-2xl overflow-hidden border border-white/[0.12] bg-surface shadow-2xl max-w-xs mx-auto lg:ml-auto">
        <img
          src={SITE.avatarSrc}
          alt={SITE.name}
          class="w-full aspect-[4/5] object-cover"
          loading="eager"
        />
        <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/90 via-black/60 to-transparent">
          <div class="font-mono text-xs font-semibold text-white tracking-wider uppercase">{SITE.name}</div>
          <div class="font-mono text-[11px] text-cyan-300/90 mt-0.5">Tech Lead · Frankfurt am Main</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4-COLUMN METRICS STRIP -->
  <section class="grid grid-cols-2 lg:grid-cols-4 gap-4 py-6">
    {HERO_METRICS.map((m) => (
      <div class="card-surface p-5">
        <div class={`font-mono text-xl sm:text-2xl font-bold tracking-tight ${metricColor[m.accent]}`}>
          {m.value}
        </div>
        <div class="text-sm font-semibold text-white mt-1">{m.label}</div>
        <div class="font-mono text-[11px] text-slate-400 mt-1 leading-relaxed">{m.sublabel}</div>
      </div>
    ))}
  </section>

  <!-- 5-CARD CREDENTIALS STRIP -->
  <section class="pt-8 pb-6">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {CREDENTIALS.map((cred) => (
        <div class="p-4 rounded-xl bg-white/[0.025] border border-white/[0.07] hover:border-white/[0.15] transition-colors">
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="font-mono text-[10px] uppercase tracking-wider text-slate-500">{cred.issuer}</span>
            <span class="px-1.5 py-0.5 rounded bg-white/[0.06] font-mono text-[10px] text-accentCyan">{cred.badge}</span>
          </div>
          <div class="text-xs font-semibold text-slate-200 leading-snug">{cred.title}</div>
          <div class="font-mono text-[10px] text-slate-500 mt-1.5">{cred.date}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- FEATURED SYSTEMS -->
  <section class="pt-14">
    <div class="flex items-end justify-between gap-4 mb-7">
      <div>
        <div class="font-mono text-xs uppercase tracking-widest text-accentAmber mb-2">★ Featured Systems</div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Hardware-software benches &amp; open-source tooling
        </h2>
      </div>
      <a href="/projects" class="hidden sm:inline-flex font-mono text-xs text-slate-400 hover:text-accentCyan transition-colors">
        All projects →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- LATEST ENGINEERING NOTES -->
  <section class="pt-20">
    <div class="flex items-end justify-between gap-4 mb-7">
      <div>
        <div class="font-mono text-xs uppercase tracking-widest text-accentCyan mb-2">// Engineering Notes</div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
          First-principles write-ups
        </h2>
      </div>
      <a href="/notes" class="font-mono text-xs text-slate-400 hover:text-accentCyan transition-colors">
        All notes →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {latestNotes.map((note) => (
        <a href={`/notes/${note.slug}`} class="card-surface p-6 group block">
          <div class="flex items-center gap-3 font-mono text-xs text-slate-500 mb-3">
            <span>{note.data.pubDate}</span>
            <span>·</span>
            <span>{note.data.readTime}</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-accentCyan transition-colors mb-2">
            {note.data.title}
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed mb-4">
            {note.data.description}
          </p>
          <div class="flex flex-wrap gap-2">
            {note.data.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded bg-white/[0.04] font-mono text-[11px] text-slate-400">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- INTRO / WORK CTA -->
  <section class="pt-20 text-center max-w-2xl mx-auto">
    <div class="font-mono text-xs uppercase tracking-widest text-accentCyan mb-2">01 · Intro</div>
    <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-4">
      From low-level bus timing to scalable test strategy
    </h2>
    <p class="text-slate-400 text-sm sm:text-base leading-relaxed mb-7">
      I focus on the intersection of embedded hardware, automotive communication protocols, and automated verification—building reliable Linux-based tooling that engineers can actually trust in the lab.
    </p>
    <div class="flex justify-center gap-3">
      <a href="/work" class="px-5 py-2.5 rounded-xl bg-white/[0.06] hover:bg-white/[0.11] border border-white/[0.1] font-mono text-xs text-white transition-colors">
        Explore Career Timeline →
      </a>
      <a href="/contact" class="px-5 py-2.5 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 border border-cyan-400/30 font-mono text-xs text-accentCyan transition-colors">
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>
