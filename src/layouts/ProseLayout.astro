---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  backHref: string;
  backLabel: string;
}

const { title, description, backHref, backLabel } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="max-w-3xl mx-auto">
    <a
      href={backHref}
      class="inline-flex items-center gap-2 font-mono text-xs text-slate-400 hover:text-accentCyan transition-colors mb-8"
    >
      ← {backLabel}
    </a>
    <slot name="header" />
    <div class="prose prose-invert prose-slate max-w-none mt-10 prose-headings:font-bold prose-headings:tracking-tight prose-a:text-accentCyan prose-code:text-cyan-300 prose-pre:bg-[#0D1117] prose-pre:border prose-pre:border-white/[0.08] prose-pre:rounded-xl">
      <slot />
    </div>
  </article>
</BaseLayout>
